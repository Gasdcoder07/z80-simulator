{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z80 IDE",
  "version": "0.1.0",
  "identifier": "com.z80ide.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Z80 Simulator IDE",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "DeveloperTool",
    "copyright": "",
    "shortDescription": "Z80 simulator, assembler and debugger"
  }
}
